{
  "expo": {
    "name": "Vizag Jobs",
    "slug": "vizag-jobs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vizagjobs",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f2557"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobsinvizag.app",
      "associatedDomains": ["applinks:jobsinvizag.in", "applinks:www.jobsinvizag.in"]
    },
    "android": {
      "package": "com.jobsinvizag.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f2557",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "jobsinvizag.in",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "https",
              "host": "jobsinvizag.in",
              "pathPrefix": "/job"
            },
            {
              "scheme": "https",
              "host": "www.jobsinvizag.in",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "https",
              "host": "www.jobsinvizag.in",
              "pathPrefix": "/job"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
