# Supabase credentials for live job data (optional).
# When unset, the app runs with bundled sample Vizag jobs.
# These mirror the web app's VITE_SUPABASE_* values (Kiran040595/vizag-jobs).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: override the jobs table name (defaults to "jobs")
# EXPO_PUBLIC_SUPABASE_JOBS_TABLE=jobs
